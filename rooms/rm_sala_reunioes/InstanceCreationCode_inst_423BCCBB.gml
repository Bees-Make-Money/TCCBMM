lore_text = "Não se sabe o que ocorreu no hotel, mas cicatrizes foram deixadas para trás. Eles não vão te deixar sair. Não confie em ninguém, não explore demais, ou o seu destino pode enfim ser selado. O colar te levará para lugares que você jamais deveria ter ido.";
hide_if = "meeting_papers_cleared";
